# DataGuard Environment Variables
# Copy this file to .env and fill in your actual values.
# .env is gitignored and should never be committed.

# PostgreSQL connection settings
DATAGUARD_DB_HOST=localhost
DATAGUARD_DB_PORT=5432
DATAGUARD_DB_NAME=dataguard
DATAGUARD_DB_USER=postgres

# PostgreSQL password (optional)
# If not set, scripts will prompt for it securely at runtime.
DATAGUARD_DB_PASSWORD=